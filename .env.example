# انسخ هذا الملف إلى .env.local وعبّ القيم. .env.local ما ينرفع لـgit.
# نفس المتغيرات تنحط في Vercel وTrigger.dev حسب جدول «متغيرات البيئة» في AGENTS.md.

# رابط التطبيق (محليًا http://localhost:3000). يُستخدم لروابط الرجوع من Google/Microsoft.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# InsForge: لوحة المشروع ⇒ Settings / API
NEXT_PUBLIC_INSFORGE_URL=
NEXT_PUBLIC_INSFORGE_ANON_KEY=
# مفتاح الأدمن (ik_...). يتجاوز RLS: خادم فقط.
INSFORGE_API_KEY=

# 32 بايت base64. ولّده بـ: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BYOK_MASTER_KEY=

# Vercel Cron keep-alive (src/app/api/cron/keepalive): stops the InsForge free project from pausing.
# Any long random string; put the same value in Vercel → Environment Variables → Production.
CRON_SECRET=

# Trigger.dev: لوحة المشروع ⇒ Project settings / API keys
TRIGGER_PROJECT_REF=
TRIGGER_SECRET_KEY=
# اختياري: مفتاح بيئة التطوير (tr_dev_...) لحساب المالك على Vercel. مهام المالك تشتغل
# على جهازه عبر `pnpm trigger:dev` (متصفح محلي، تشغيلات التطوير ما تنحسب).
TRIGGER_OWNER_SECRET_KEY=

# اختياري (جهاز المالك): المتصفح المحلي للتقديم. chrome أو msedge. الافتراضي chrome.
LOCAL_BROWSER_CHANNEL=chrome
