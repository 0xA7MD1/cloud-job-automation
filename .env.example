# انسخ هذا الملف إلى .env.local وعبّ القيم. .env.local ما ينرفع لـgit.
# نفس المتغيرات تنحط في Vercel وTrigger.dev حسب جدول «متغيرات البيئة» في AGENTS.md.

# رابط التطبيق (محليًا http://localhost:3000). يُستخدم لروابط الرجوع من Google/Microsoft.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# InsForge: لوحة المشروع ⇒ Settings / API
NEXT_PUBLIC_INSFORGE_URL=
NEXT_PUBLIC_INSFORGE_ANON_KEY=
# مفتاح الأدمن (ik_...). يتجاوز RLS: خادم فقط.
INSFORGE_API_KEY=

# 32 بايت base64. ولّده بـ: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BYOK_MASTER_KEY=

# Trigger.dev: لوحة المشروع ⇒ Project settings / API keys
TRIGGER_PROJECT_REF=
TRIGGER_SECRET_KEY=
